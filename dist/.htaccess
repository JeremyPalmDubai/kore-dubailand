Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
RewriteEngine On
# Consolidate the deployment copy on the public URLs.
RewriteRule ^dist/(.*)$ /$1 [R=301,L]
RewriteRule ^$ /en/invest-in-dubai-kore-imtiaz/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>
<FilesMatch "^(configure-site\.py|input\.css|package\.json|pnpm-lock\.yaml|routes\.json|post-routes\.json|README\.md)$">
Require all denied
</FilesMatch>
